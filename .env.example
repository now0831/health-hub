# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 커밋되지 않습니다)

# PostgreSQL — docker-compose.yml 기본값
DATABASE_URL="postgresql://health:health@localhost:5432/health"

# 동기화 앱 → 서버 인증 토큰. 아래 명령으로 생성:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 같은 값을 apps/sync-app 의 설정 화면에도 입력합니다.
SYNC_TOKEN=""

# `npm run db:dev -w @health/db` (Docker 없이 쓰는 로컬 DB) 를 쓸 때만 1 로 설정.
# 동시 연결에 약해서 연결 수를 하나로 제한해야 페이지가 안정적으로 열립니다.
# DATABASE_POOL_MAX=1
